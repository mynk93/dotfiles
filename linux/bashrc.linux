# ~/.config/bash/bashrc.linux — Linux dev-box shell config.
#
# Sourced from ~/.bashrc by linux/bootstrap.sh. This is the bash
# counterpart to ~/.config/zsh on macOS: it mirrors the parts that carry
# over and drops the parts that don't (antidote plugins, zstyle menu
# completion, the mynk.zsh prompt, the add-zsh-hook project loader).
#
# Every tool-dependent alias is guarded on the tool being present, so this
# file is safe to source on a box where install-tools.sh hasn't run.

# ── Environment ────────────────────────────────────────────
# Mirrors ~/.zshenv. EDITOR is vim rather than `zed --wait` — there is no
# GUI editor on a remote box, and vim needs no --wait since it blocks.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export EDITOR='vim'
export VISUAL="$EDITOR"
export VIRTUAL_ENV_DISABLE_PROMPT=1

# PATH comes first: every `command -v` guard in this file probes it, and
# install-tools.sh puts its binaries here. A guard that runs earlier sees
# none of them on a box whose own ~/.bashrc doesn't already add this dir.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# moor is the pager when install-tools.sh has fetched it, matching .zshenv;
# less stays the fallback for a box where it hasn't run yet.
command -v moor >/dev/null 2>&1 && export PAGER='moor'

# less defaults for tools that bypass $PAGER and call less directly:
#   -F quit if content fits on one screen
#   -R render raw ANSI colour escapes
#   -X don't clear screen on exit (preserve scrollback)
export LESS='-FRX'

# ── History ────────────────────────────────────────────────
# Closest bash equivalents to the setopt block in .zshrc.
HISTSIZE=50000
HISTFILESIZE=50000
HISTCONTROL=ignoredups:ignorespace   # HIST_IGNORE_DUPS + HIST_IGNORE_SPACE
HISTTIMEFORMAT='%F %T '              # EXTENDED_HISTORY
shopt -s histappend                  # never clobber another shell's history
shopt -s cmdhist                     # keep a multi-line command on one line

# Flush each command immediately so parallel shells interleave rather than
# overwrite. This is as close as bash gets to zsh's SHARE_HISTORY; it does
# not re-read other shells' entries into the current session.
case "${PROMPT_COMMAND:-}" in
    *'history -a'*) ;;
    '') PROMPT_COMMAND='history -a' ;;
    *)  PROMPT_COMMAND="history -a; $PROMPT_COMMAND" ;;
esac

# ── Shell behaviour ────────────────────────────────────────
shopt -s autocd cdspell dirspell checkwinsize globstar

# ── Directory listing ──────────────────────────────────────
# The shorthands chain through the `ls` alias exactly as they do in zsh —
# bash re-expands the first word of an alias body, so `l` resolves to
# `eza -lah` when eza is present and `ls --color=auto -lah` when it isn't.
if command -v eza >/dev/null 2>&1; then
    alias ls='eza'
else
    alias ls='ls --color=auto'
fi
alias l='ls -lah'
alias la='ls -lAh'
alias ll='ls -lh'
alias lsa='ls -lah'

# ── CLI replacements ───────────────────────────────────────
command -v bat  >/dev/null 2>&1 && alias cat='bat'
command -v fd   >/dev/null 2>&1 && alias find='fd'
command -v glow >/dev/null 2>&1 && alias view='glow -p'
command -v btop >/dev/null 2>&1 && alias top='btop' && alias htop='btop'

# `grep` is deliberately NOT aliased to rg — the CLI gap (-E, -P,
# --include, recursion semantics) creates more surprises than it solves.
# Use rg directly. Keep the colour alias the base image ships with.
alias grep='grep --color=auto'

# ── Navigation ─────────────────────────────────────────────
alias phome='cd ~/dev/work'
alias sandbox='cd ~/sandbox'
alias sshhome='cd ~/.ssh'
alias cconfig='cd ~/.claude'

# ── Edit common configs ────────────────────────────────────
alias sshconfig='$EDITOR ~/.ssh/config'
alias gitconfig='$EDITOR ~/.gitconfig'
alias bashconfig='$EDITOR ~/.config/bash/bashrc.linux'
alias bashsource='source ~/.bashrc'

# ── Tooling shortcuts ──────────────────────────────────────
alias cc='claude'
command -v lazygit >/dev/null 2>&1 && alias lzh='lazygit'
# Linux analogue of the macOS `ipconfig getifaddr en0`.
alias ip='hostname -I | cut -d" " -f1'

# ── Tool integrations ──────────────────────────────────────
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"

if command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --bash)"
    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
    fi
fi

# ── Interactive-only setup ─────────────────────────────────
# readline `bind` errors out in a non-interactive shell, and bash sources
# ~/.bashrc for non-interactive ssh commands, so this must stay guarded or
# every `ssh box <cmd>` prints warnings and scp/rsync break.
if [[ $- == *i* ]]; then
    bind 'set completion-ignore-case on'
    bind 'set show-all-if-ambiguous on'
    bind 'set colored-stats on'

    # Up/Down do prefix-aware history search, the closest bash gets to
    # zsh-history-substring-search: type a prefix, then press Up.
    bind '"\e[A": history-search-backward'
    bind '"\e[B": history-search-forward'

    # Alt-Left / Alt-Right jump per word.
    bind '"\e[1;3D": backward-word'
    bind '"\e[1;3C": forward-word'
fi

# ── Machine-specific overrides ─────────────────────────────
# Not in version control. Work tokens, machine-specific paths, etc.
[[ -f "$HOME/.config/bash/local.bash" ]] && . "$HOME/.config/bash/local.bash"

# ── Supervised services ────────────────────────────────────
# PID 1 on these pods is s6-svscan over /var/run/s6/services, and /var/run is
# tmpfs: every service directory is erased on a pod restart while the
# definitions in ~/.config/s6-user survive. Re-register on each interactive
# login so the box heals on the first shell after a restart. Idempotent and
# cheap (a few ms); an already-registered service is left untouched. The log
# is overwritten rather than appended so it never grows. See linux/README.md,
# "Boot-time recovery", for the build-script hook that removes the login
# dependency altogether.
if [[ $- == *i* ]] && [[ -d /var/run/s6/services && -x "$HOME/.local/bin/s6-user-services-install" ]]; then
    mkdir -p "$HOME/.local/state"
    "$HOME/.local/bin/s6-user-services-install" > "$HOME/.local/state/s6-user-install.log" 2>&1
fi

# ── T3 Code update ─────────────────────────────────────────
# The desktop app offers to update the server but cannot: remote updates go
# through `t3 service install`, which wants systemd. So it is two commands,
# and they have to run together -- T3 lazy-loads hashed chunks from the
# package directory, so a running server whose package was replaced underneath
# it starts reaching for files that no longer exist. The restart drops live
# connections; threads resume from state.sqlite.
#
# Channel: the argument if given, else $T3_CHANNEL (set it in local.bash),
# else whatever the installed build already is -- a nightly stays nightly.
update-t3() {
    local channel="${1:-${T3_CHANNEL:-}}"
    if [[ -z "$channel" ]]; then
        case "$(t3 --version 2>/dev/null)" in
            *nightly*) channel=nightly ;;
            *preview*) channel=preview ;;
            *)         channel=latest  ;;
        esac
    fi
    echo "update-t3: installing t3@${channel}" \
        && npm i -g --allow-scripts=msgpackr-extract,node-pty "t3@${channel}" \
        && s6-svc -wr -T 30000 -r /var/run/s6/services/t3-serve \
        && s6-svstat /var/run/s6/services/t3-serve \
        && t3 --version
}

# ── Idle-shutdown sentinel ─────────────────────────────────
# TrueFoundry stops the pod when it judges it idle. Its own definition, from
# the deployment form: "The instance is considered active if there is at least
# one active SSH connection, or if a background job is running using tmux or
# screen, or if the pod has restarted."
#
# An s6 service does not qualify. The judge counts processes that own a
# controlling terminal and sit in its foreground group, and a supervised
# service has no terminal -- so t3-serve and cliproxyapi are invisible to it.
# A tmux-hosted job is the sanctioned answer, and this is the smallest one
# that exists. Idempotent: the has-session check makes re-sourcing a no-op.
if [[ $- == *i* ]] && command -v tmux >/dev/null 2>&1; then
    tmux has-session -t keep 2>/dev/null || \
        tmux new-session -d -s keep 'exec sleep infinity'
fi

# ── SSH agent ──────────────────────────────────────────────
# One agent per box, shared by every ssh login and tmux pane. There is no
# systemd user session and no macOS Keychain here, so the socket lives at a
# fixed path and an agent is spawned only when nothing answers on it.
# Idempotent: re-sourcing finds the running agent and reuses it.
#
# Strictly a convenience — the GitHub key has no passphrase and
# ~/.ssh/config points at it with IdentityFile, so git works without this.
# The agent matters for agent forwarding and for any key added later that
# does carry a passphrase.
if [[ $- == *i* ]]; then
    export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
    ssh-add -l >/dev/null 2>&1
    # 2 = nothing answered on the socket; 1 = agent is up but holds no keys.
    if [[ $? -eq 2 ]]; then
        rm -f "$SSH_AUTH_SOCK"
        ssh-agent -a "$SSH_AUTH_SOCK" >/dev/null 2>&1
    fi

    # Match on fingerprint, not path: ssh-add -l prints the key comment.
    if [[ -f "$HOME/.ssh/id_ed25519_github" ]]; then
        _gh_fp=$(ssh-keygen -lf "$HOME/.ssh/id_ed25519_github.pub" 2>/dev/null | awk '{print $2}')
        ssh-add -l 2>/dev/null | grep -qF "$_gh_fp" || \
            ssh-add -q "$HOME/.ssh/id_ed25519_github" 2>/dev/null
        unset _gh_fp
    fi
fi
