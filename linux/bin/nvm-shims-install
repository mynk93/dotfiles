#!/bin/sh
# Put node and its globally-installed CLIs on the PATH of a shell that never
# sources ~/.bashrc.
#
# nvm is a shell function, so `ssh box 'node -v'` — and anything T3 Code or a
# supervised s6 service runs — sees no node at all. Symlinking into
# ~/.config/nvm/versions/node/v24.21.0/bin would fix that until the next `nvm
# install`, which changes the version in the path. These shims resolve the
# newest installed version at call time instead, so a node upgrade needs no
# re-run.
#
# The shim prepends the resolved bin dir to PATH *and* execs an absolute path.
# Both are needed: npm, npx, t3 and codex all carry a `#!/usr/bin/env node`
# shebang and spawn further `node` children, which only resolve if the real
# node is ahead of this directory on PATH. For the same reason no shim may
# ever call `node` by name — with ~/.local/bin first that is a fork bomb.
set -e
BIN_DIR="${1:-$HOME/.local/bin}"
mkdir -p "$BIN_DIR"
for cmd in node npm npx t3 codex; do
    cat > "$BIN_DIR/$cmd" <<SHIM
#!/bin/sh
# Generated by nvm-shims-install. Do not edit; regenerate instead.
NVM_BIN="\$(ls -d "\$HOME/.config/nvm/versions/node/v"*/bin 2>/dev/null | sort -V | tail -1)"
if [ -z "\$NVM_BIN" ] || [ ! -x "\$NVM_BIN/$cmd" ]; then
    echo "$cmd: not installed under \$HOME/.config/nvm/versions/node" >&2
    exit 127
fi
PATH="\$NVM_BIN:\$PATH"
export PATH
exec "\$NVM_BIN/$cmd" "\$@"
SHIM
    chmod 755 "$BIN_DIR/$cmd"
done
echo "nvm shims installed in $BIN_DIR: node npm npx t3 codex"
