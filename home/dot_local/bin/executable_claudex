#!/bin/sh
# claudex — the Claude Code harness driving GPT-6 Astra through the local
# CLIProxyAPI on :8317.
#
# Script form (rather than only a zsh alias) so non-interactive callers can use
# it too: skills, `cmux send`, background Bash tasks, and anything else that
# runs without sourcing ~/.config/zsh/local.zsh.
#
# Defaults are set before "$@" so any flag you pass wins over them:
#   claudex                        -> interactive session, astra @ high
#   claudex --effort xhigh -p "..." -> headless, effort overridden to xhigh
#   claudex --model gpt-5.6-sol    -> different model, same proxy

set -eu

KEY_FILE="${CLIPROXY_KEY_FILE:-$HOME/.config/cliproxyapi/key}"
BASE_URL="${CLIPROXY_BASE_URL:-http://127.0.0.1:8317}"

if [ ! -r "$KEY_FILE" ]; then
  echo "claudex: proxy key not readable at $KEY_FILE" >&2
  exit 1
fi

# Fail loudly here rather than letting Claude Code report an opaque auth error.
if ! curl -fsS --max-time 3 -o /dev/null \
     -H "Authorization: Bearer $(cat "$KEY_FILE")" "$BASE_URL/v1/models"; then
  echo "claudex: CLIProxyAPI not answering at $BASE_URL" >&2
  echo "         try: brew services restart cliproxyapi" >&2
  exit 1
fi

export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_AUTH_TOKEN="$(cat "$KEY_FILE")"

# Claude Code's background haiku calls would otherwise ask the proxy for a
# claude-* model it holds no credential for.
export ANTHROPIC_DEFAULT_HAIKU_MODEL=gpt-5.6-luna

# Astra's raw window is 1.05M, but OpenAI re-prices the WHOLE request at 2x
# input and 1.5x output once a prompt passes 272k input tokens. Codex dodges
# that cliff by compacting at context_window * effective_context_window_percent
# (272000 * 0.95 = 258400) and we mirror its limit rather than sit on the
# boundary. Raising this above 272000 doubles the bill; see openai/codex#32486.
# Without the variable Claude Code does not recognize the model and assumes
# 200k, compacting early.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=258400

export CLAUDE_CODE_SUBAGENT_MODEL=gpt-6-astra
export CLAUDE_CODE_ALWAYS_ENABLE_EFFORT=1
export CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY=3
export ENABLE_TOOL_SEARCH=false

exec claude --model gpt-6-astra --effort high "$@"
