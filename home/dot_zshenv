# ~/.zshenv — sourced by EVERY zsh invocation (interactive, login, scripts).
# Keep this minimal: env vars and PATH only. No interactive setup.

# Redirect zsh's per-user config files to ~/.config/zsh/.
export ZDOTDIR="$HOME/.config/zsh"

# XDG base dirs — many tools (lazygit, btop, gh, etc.) honour this and
# will look under ~/.config/<tool>/ instead of platform-native paths.
export XDG_CONFIG_HOME="$HOME/.config"

# Homebrew (Apple Silicon).
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Local user binaries.
export PATH="$HOME/.local/bin:$PATH"

# GPG agent integration for commit signing.
export GPG_TTY=$(tty)

# Suppress Python venv activate-script (venv) PROMPT prefix — the prompt
# renders its own venv segment.
export VIRTUAL_ENV_DISABLE_PROMPT=1

# No gap between RPROMPT and the right edge.
export ZLE_RPROMPT_INDENT=0

# Default pager. moor is a Rust-based less replacement with native
# mouse/trackpad support, ANSI-aware (passes through colours from glow
# etc. without re-styling), and quit-on-fit by default. Used by tools
# that honour $PAGER (man, glow, bat-as-pager via fallback chain, …).
export PAGER='moor'

# Fallback `less` defaults for the rare tool that bypasses $PAGER and
# calls less directly:
#   -F quit if content fits on one screen
#   -R render raw ANSI colour escapes
#   -X don't clear screen on exit (preserve scrollback)
export LESS='-FRX'
