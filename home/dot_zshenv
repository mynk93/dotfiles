# ~/.zshenv — sourced by EVERY zsh invocation (interactive, login, scripts).
# Keep this minimal: env vars and PATH only. No interactive setup.

# Redirect zsh's per-user config files to ~/.config/zsh/.
export ZDOTDIR="$HOME/.config/zsh"

# XDG base dirs — many tools (lazygit, btop, gh, etc.) honour this and
# will look under ~/.config/<tool>/ instead of platform-native paths.
export XDG_CONFIG_HOME="$HOME/.config"

# Homebrew (Apple Silicon).
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Local user binaries. -U keeps one copy of each entry when a nested shell
# sources this file again.
typeset -U path PATH
export PATH="$HOME/.local/bin:$PATH"

# GPG agent integration for commit signing. Only with a terminal: without
# one `tty` prints "not a tty", and that text would become the value.
[[ -t 0 ]] && export GPG_TTY=$(tty)

# Debian and Ubuntu's /etc/zsh/zshrc runs compinit before ~/.zshrc does.
# .zshrc runs it itself, after the plugins have extended fpath, so the global
# one is a wasted pass that also leaves a second dump file behind.
skip_global_compinit=1

# Default editor. `--wait` is required so tools that read the saved file
# (git commit, crontab -e, gh pr create, visudo) block until zed closes
# the buffer. Without it, zed forks immediately and the parent sees an
# empty file. Git's core.editor in dot_gitconfig.tmpl matches.
#
# Linux gets vim: ubuntu/bootstrap.sh deploys this file to machines with no
# GUI editor, and vim already blocks, so it needs no --wait.
if [[ "$OSTYPE" == darwin* ]]; then
    export EDITOR='zed --wait'
else
    export EDITOR='vim'
fi
export VISUAL="$EDITOR"

# Suppress Python venv activate-script (venv) PROMPT prefix — the prompt
# renders its own venv segment.
export VIRTUAL_ENV_DISABLE_PROMPT=1

# No gap between RPROMPT and the right edge.
export ZLE_RPROMPT_INDENT=0

# Default pager. moor is a Rust-based less replacement with native
# mouse/trackpad support, ANSI-aware (passes through colours from glow
# etc. without re-styling), and quit-on-fit by default. Used by tools
# that honour $PAGER (man, glow, bat-as-pager via fallback chain, …).
export PAGER='moor'

# Fallback `less` defaults for the rare tool that bypasses $PAGER and
# calls less directly:
#   -F quit if content fits on one screen
#   -R render raw ANSI colour escapes
#   -X don't clear screen on exit (preserve scrollback)
export LESS='-FRX'
