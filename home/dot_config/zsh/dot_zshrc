# ~/.config/zsh/.zshrc — interactive zsh setup.
# (Env vars and PATH live in ~/.zshenv.)

# ── History (OMZ-compatible defaults) ──────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000

setopt EXTENDED_HISTORY        # record command timestamp in HISTFILE
setopt HIST_EXPIRE_DUPS_FIRST  # drop oldest dup first when HISTFILE > HISTSIZE
setopt HIST_IGNORE_DUPS        # ignore consecutive duplicate commands
setopt HIST_IGNORE_SPACE       # ignore commands starting with a space
setopt HIST_VERIFY             # show expanded history command before running it
setopt SHARE_HISTORY           # share history across all running shells

# ── Line editing ──────────────────────────────────────────
# Drop "/" from WORDCHARS so Alt-Left/Right (backward-word/forward-word)
# and Alt-Backspace (backward-kill-word) jump per path segment instead of
# treating /a/long/path as one word.
WORDCHARS="${WORDCHARS//\//}"

# ── Plugins via antidote ────────────────────────────────────
source "$(brew --prefix)/opt/antidote/share/antidote/antidote.zsh"
antidote load

# Bind up/down to substring-aware history search (provided by
# zsh-users/zsh-history-substring-search). Type a prefix, press ↑ to
# cycle through matching history entries — OMZ's default behavior.
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# ── Tool integrations ─────────────────────────────────────
# Smart cd via zoxide. `z foo` jumps to the most-frecent dir matching
# foo; `zi` opens an interactive picker. Plain `cd` still works.
eval "$(zoxide init zsh)"

# Fuzzy finder. Bindings:
#   Ctrl-R — fuzzy history search
#   Ctrl-T — insert file path
#   Alt-C  — cd to a fuzzy-picked directory
source <(fzf --zsh)

# Use fd as fzf's source — respects .gitignore and is faster than find.
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

# ── Completion ─────────────────────────────────────────────
# zsh-completions added new completion files via fpath (loaded above by
# antidote). compinit activates the whole completion system.
autoload -Uz compinit
compinit -d "${ZDOTDIR:-$HOME}/.zcompdump-${HOST}"

# Menu-style completion: a single Tab opens an interactive menu;
# arrow keys navigate; Tab or Enter selects; Esc cancels.
zstyle ':completion:*' menu select

# Case-insensitive matching: `cd doc<Tab>` matches `Documents`.
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Group results by category, with a yellow header per group.
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}── %d ──%f'

# `cd` completion: prefer subdirectories of the current path. (Default
# behaviour also pulls in named-dirs / cdpath, which is what produces
# the "past usage" results.)
zstyle ':completion:*:cd:*' tag-order local-directories

# Tab → menu-select completion only (overrides fzf's Tab binding from
# `fzf --zsh` above — fzf is still reachable via Ctrl-T / Alt-C / Ctrl-R).
# Autosuggestion acceptance is on Right Arrow instead, so Tab is always
# free for completing filenames in the current directory.
bindkey '^I' expand-or-complete

# Right Arrow accepts the autosuggestion ghost (in addition to its default
# forward-char behavior — zsh-autosuggestions hooks forward-char as an
# accept widget out of the box; binding it explicitly documents the intent).
bindkey '^[[C' autosuggest-accept

# ── Theme ──────────────────────────────────────────────────
source "${ZDOTDIR:-$HOME}/themes/mynk.zsh"

# ── Aliases & functions ────────────────────────────────────
source "${ZDOTDIR:-$HOME}/aliases.zsh"
source "${ZDOTDIR:-$HOME}/functions.zsh"

# ── Project-local zshrc (allowlisted) ──────────────────────
# When cd'ing into an allowlisted project, source its .zshrc.local in the
# parent shell (so things like completions can take effect). Loads once
# per shell per project. Allowlist exists to prevent random ./.zshrc.local
# files from auto-running.
autoload -U add-zsh-hook
_project_zshrc_allowlist=(
    "$HOME/dev/work/agent-orchestrator"
)
_load_project_zshrc() {
    local prefix
    for prefix in "${_project_zshrc_allowlist[@]}"; do
        [[ "$PWD/" == "$prefix"/* ]] || continue
        local key="_PROJECT_ZSHRC_LOADED_${prefix//[^A-Za-z0-9]/_}"
        [[ -n ${(P)key} ]] && return
        [[ -f "$prefix/.zshrc.local" ]] || return
        source "$prefix/.zshrc.local"
        typeset -g "$key=1"
        return
    done
}
add-zsh-hook chpwd _load_project_zshrc
_load_project_zshrc

# ── Machine-specific overrides ─────────────────────────────
# Not in version control. Used for work tokens, machine-specific paths, etc.
[[ -f "${ZDOTDIR:-$HOME}/local.zsh" ]] && source "${ZDOTDIR:-$HOME}/local.zsh"
