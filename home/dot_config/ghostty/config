# Ghostty — the terminal engine cmux embeds.
#
# Font and palette live here, NOT in cmux's settings.json. cmux's schema says
# its adaptive default palette applies "unless a Ghostty theme or terminal
# colors are configured", so this file wins once it exists.
#
# cmux ships its own Ghostty at
#   /Applications/cmux.app/Contents/Resources/bin/ghostty
# Use it to inspect things: `ghostty +list-themes`, `ghostty +show-config`.

# ── Font ───────────────────────────────────────────────────────────────────
# Same family as the old zed config and the mynk.zsh prompt, which needs the
# Nerd Font glyphs to avoid rendering tofu.
font-family = "FiraCode Nerd Font Mono"
font-size = 14

# FiraCode's ligatures: -> => != <= become single glyphs. Turn off by
# commenting this out if they get in the way when reading diffs.
font-feature = calt
font-feature = liga
font-thicken = true

# Route every Nerd Font glyph range to a dedicated symbols font.
#
# Ghostty only accepts monospace families (`ghostty +list-fonts` lists exactly
# one FiraCode family: the Mono variant), and the Mono build squeezes Nerd Font
# glyphs into a single cell — which is why heading and fold icons render as
# cramped marks. Symbols Nerd Font Mono draws them at the intended proportions
# while FiraCode keeps the text.
#
# Ranges are the Nerd Fonts v3 allocations; the Material Design block at the
# end is where render-markdown's heading icons live (U+F0CA1 and friends).
font-codepoint-map = U+E000-U+E00A=Symbols Nerd Font Mono
font-codepoint-map = U+EA60-U+EBEB=Symbols Nerd Font Mono
font-codepoint-map = U+E0A0-U+E0C8=Symbols Nerd Font Mono
font-codepoint-map = U+E0CA=Symbols Nerd Font Mono
font-codepoint-map = U+E0CC-U+E0D7=Symbols Nerd Font Mono
font-codepoint-map = U+E200-U+E2A9=Symbols Nerd Font Mono
font-codepoint-map = U+E300-U+E3E3=Symbols Nerd Font Mono
font-codepoint-map = U+E5FA-U+E6B7=Symbols Nerd Font Mono
font-codepoint-map = U+E700-U+E8EF=Symbols Nerd Font Mono
font-codepoint-map = U+ED00-U+EFCE=Symbols Nerd Font Mono
font-codepoint-map = U+F000-U+F2FF=Symbols Nerd Font Mono
font-codepoint-map = U+F300-U+F381=Symbols Nerd Font Mono
font-codepoint-map = U+F400-U+F533=Symbols Nerd Font Mono
font-codepoint-map = U+F0001-U+F1AF0=Symbols Nerd Font Mono

# ── Theme ──────────────────────────────────────────────────────────────────
# Matches the nvim colorscheme and the `view` alias (glow style: dracula).
# Dracula is dark-only — there is no light variant to pair for auto-switching.
theme = Dracula

# ── Chrome ─────────────────────────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true
scrollback-limit = 100000

# Ghostty draws its own splits/tabs; cmux manages panes itself, so leave the
# decorations to cmux and keep this surface plain.
window-decoration = false
