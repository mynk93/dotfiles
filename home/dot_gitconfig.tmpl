[user]
	name = {{ .name }}
	email = {{ .email }}
{{- if .gpg_signingkey }}
	signingkey = {{ .gpg_signingkey }}
{{- end }}
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	owner = !git shortlog -sn --no-merges
	cluster = !git log --format=format: --name-only --since='1 year ago' | sort | uniq -c | sort -nr | head -20
	velocity = !git log --format='%ad' --date=format:'%Y-%m' | sort | uniq -c
	bugview = !git log -i -E --grep='fix|fixes|bug|broken|bugfix' --name-only --format='' | sort | uniq -c | sort -nr | head -20
	fire = !git log --color=always --oneline --since='1 year ago' | grep --color=never -iE 'revert|hotfix|emergency|rollback'
{{- if .gpg_signingkey }}
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- end }}
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
	light = false
[alias]
	# Structural (AST) diff via difftastic. Deliberately an alias rather
	# than diff.external: difft output is for human eyes only — it is not
	# a valid patch, so a global setting would break `git add -p`,
	# `git apply`, and delta.
	dft = -c diff.external=difft diff
	dfts = -c diff.external=difft show
[merge]
	conflictstyle = diff3
[diff]
	# zebra alternates shading between moved blocks, so a block that moved
	# reads as moved instead of as a delete plus an unrelated add. delta
	# renders these via --inspect-raw-lines, which is on by default.
	colorMoved = zebra
	# A block that moved into or out of an if/try changes indentation but
	# not content; without this it fails the move match and shows as a
	# rewrite.
	colorMovedWS = allow-indentation-change
	# histogram beats myers at keeping moved/reordered hunks aligned.
	algorithm = histogram
	# Detect renames and copies, the file-level half of what a semantic
	# diff gives you.
	renames = copies
