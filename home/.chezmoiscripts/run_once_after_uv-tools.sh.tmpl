#!/usr/bin/env bash
# Install global Python CLIs via `uv tool`.
# Runs once per machine after the Brewfile has provided `uv`.
set -euo pipefail

# Ensure Apple Silicon brew (hence uv) is on PATH when chezmoi runs this
# from a non-login shell during bootstrap.
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "uv not found; skipping global tool install (expected uv from Brewfile)." >&2
    exit 0
fi

# `uv tool install` is idempotent — re-running is a no-op if already present.
uv tool install truefoundry   # TrueFoundry CLI (provides `tfy`)
