# defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false      # off auto-capitalize
# defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false    # off "smart" dashes
# defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false   # off "smart" quotes

