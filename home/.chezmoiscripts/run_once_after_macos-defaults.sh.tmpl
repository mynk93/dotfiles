#!/usr/bin/env bash
# macOS system defaults. Re-runs whenever this file's content changes.
# Uncomment entries you want applied, then run: chezmoi apply

set -euo pipefail

{{- if ne .chezmoi.os "darwin" }}
echo "Not macOS — skipping defaults."
exit 0
{{- end }}

