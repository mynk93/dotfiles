#!/usr/bin/env bash
set -euo pipefail

# Install Homebrew if missing.
if ! command -v brew >/dev/null 2>&1; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Apple Silicon brew lives at /opt/homebrew; ensure shellenv is loaded.
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Newer Homebrew refuses to load formulae from untrusted third-party taps,
# which would abort `brew bundle` on the databricks/tap entry
# (see https://docs.brew.sh/Tap-Trust). Pre-tap and trust it. Both lines are
# tolerant of failure so this stays a no-op on Homebrew versions predating
# the trust requirement (where `brew trust` does not exist).
brew tap databricks/tap 2>/dev/null || true
brew trust databricks/tap 2>/dev/null || true

# Some casks (wireshark-app) ship .pkg payloads that Homebrew installs via
# sudo. sudo needs a TTY to prompt, and `brew bundle` gives it none partway
# through a run, so it aborts. Cache the credential up front and hold it with
# a keepalive for the duration of the bundle. Skipped when stdin isn't a
# terminal (CI, `chezmoi apply` from a pipe) -- there is no password to read
# there, so let the pkg cask fail loudly instead of hanging.
if [[ -t 0 ]]; then
    echo "==> Homebrew needs sudo for .pkg-bearing casks; priming credential."
    sudo -v
    while sudo -n true 2>/dev/null; do
        sleep 60
        kill -0 "$$" 2>/dev/null || break
    done &
    sudo_keepalive=$!
    trap 'kill "${sudo_keepalive}" 2>/dev/null || true' EXIT
fi

# Install/update everything declared in Brewfile.
brew bundle --file="{{ .chezmoi.workingTree }}/Brewfile"
