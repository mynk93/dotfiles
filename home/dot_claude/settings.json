{
  "permissions": {
    "deny": [
      "Skill(proPlugins:pro-pr-description)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/context-bar.sh"
  },
  "enabledPlugins": {
    "proPlugins@proPlugins": true,
    "proagent-pipeline@proagent": true,
    "proagent-ops@proagent": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "proPlugins": {
      "source": {
        "source": "github",
        "repo": "prodigal-tech/code-agent-plugins"
      }
    },
    "proagent": {
      "source": {
        "source": "github",
        "repo": "prodigal-tech/proagent-plugins"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "default",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
